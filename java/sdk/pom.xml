<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>ai.motif</groupId>
    <artifactId>partner-java</artifactId>
    <version>0.2.0</version>
  </parent>
  <artifactId>motif-sdk</artifactId>
  <name>Motif Java SDK</name>
  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openapitools</groupId>
      <artifactId>jackson-databind-nullable</artifactId>
      <version>0.2.12</version>
    </dependency>
    <dependency>
      <groupId>jakarta.annotation</groupId>
      <artifactId>jakarta.annotation-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>7.26.0</version>
        <executions>
          <execution>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/openapi/motif.json</inputSpec>
              <generatorName>java</generatorName>
              <library>native</library>
              <apiPackage>ai.motif.sdk.api</apiPackage>
              <modelPackage>ai.motif.sdk.model</modelPackage>
              <invokerPackage>ai.motif.sdk.client</invokerPackage>
              <schemaMappings>
                <schemaMapping>sdk_profile_getAnswers_200_response_inner_value=com.fasterxml.jackson.databind.JsonNode</schemaMapping>
                <schemaMapping>AnyOf=com.fasterxml.jackson.databind.JsonNode</schemaMapping>
              </schemaMappings>
              <typeMappings>
                <typeMapping>AnyOf=com.fasterxml.jackson.databind.JsonNode</typeMapping>
                <typeMapping>anyOf=com.fasterxml.jackson.databind.JsonNode</typeMapping>
              </typeMappings>
              <importMappings>
                <importMapping>AnyOf=com.fasterxml.jackson.databind.JsonNode</importMapping>
              </importMappings>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelDocumentation>false</generateModelDocumentation>
              <configOptions>
                <supportUrlQuery>false</supportUrlQuery>
                <useJakartaEe>true</useJakartaEe>
                <openApiNullable>true</openApiNullable>
                <useBeanValidation>false</useBeanValidation>
                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                <serializationLibrary>jackson</serializationLibrary>
                <useOneOfInterfaces>true</useOneOfInterfaces>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
