{
  "name": "motif-partner-reference-implementations",
  "private": true,
  "type": "module",
  "scripts": {
    "sdk": "node --env-file-if-exists=.env sdk/main.ts",
    "rest": "node --env-file-if-exists=.env rest/main.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test:java": "MOTIF_TEST_JAVA=1 node --test tests/lifecycle.test.ts"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "6.0.3",
    "@biomejs/biome": "2.5.14"
  },
  "engines": {
    "node": ">=24.18.0"
  }
}
