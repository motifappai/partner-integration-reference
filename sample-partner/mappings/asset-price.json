{
  "eventType": "ai.motif.asset.price.v1",
  "enabled": true,
  "source": "urn:sample-partner:prices",
  "match": { "pointer": "/kind", "equals": "price" },
  "idPointer": "/eventId",
  "timePointer": "/observedAt",
  "subjectPointer": "/securityId",
  "fields": {
    "externalId": "/securityId",
    "asOf": "/observedAt",
    "revision": "/version",
    "unitPrice": "/quote/px",
    "currency": "/quote/ccy"
  },
  "constants": { "priceType": "CLOSE", "adjustment": "UNADJUSTED" }
}
